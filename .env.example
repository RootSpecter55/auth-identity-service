# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Set to true behind a load balancer, so the client IP (for throttling) comes from X-Forwarded-For.
TRUST_PROXY=false

# --- Secrets loading (scripts/start-with-secrets.ts) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Database and Redis ---
DATABASE_URL=postgresql://app:app@localhost:5448/identity
REDIS_URL=redis://localhost:6383/0

# --- Encryption at rest ---
# 32 random bytes, base64. Encrypts local signing keys and TOTP secrets (AES-256-GCM).
# The value below is a published dev-only key: replace it everywhere except local development.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=

# --- Tokens ---
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Signing keys (KeyStore) ---
# local: private keys encrypted in Postgres. kms: AWS KMS asymmetric keys (signing happens in KMS).
KEY_STORE=local

# --- Email (EmailProvider) ---
# fake: stored in the dev_emails table. ses: Amazon SES v2.
EMAIL_PROVIDER=fake
EMAIL_FROM=no-reply@example.com
# Base URL used in links inside emails.
APP_URL=http://localhost:3000
# GET /dev/emails, to read fake emails. Only allowed with EMAIL_PROVIDER=fake; never in production.
DEV_ENDPOINTS=true

# --- Login throttling (Redis) ---
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_THROTTLE_WINDOW_SECONDS=900
